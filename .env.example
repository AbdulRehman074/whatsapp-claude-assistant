# Copy to .env and fill in. Never share or commit .env.

# Only for running outside Render (Render sets its own address automatically)
PUBLIC_URL=http://localhost:3000

# From console.anthropic.com > API keys
ANTHROPIC_API_KEY=
# Draft quality. claude-haiku-5-5 is cheaper if volume grows.
CLAUDE_MODEL=claude-sonnet-5-5

TIMEZONE=Europe/Amsterdam
# Wait this long after a customer's last message before drafting (they often send 2-3 in a row)
DEBOUNCE_SECONDS=60
# Stored messages are deleted after this many days
RETENTION_DAYS=30
D360_BASE_URL=https://waba-v2.360dialog.io

# Testing only: 1 = no Claude calls (rough built-in sorting), 1 = never send WhatsApp messages
MOCK_CLAUDE=0
DRY_RUN_SEND=0
